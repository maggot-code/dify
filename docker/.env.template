# ============================================================================
# Dify Docker Compose 配置文件 - 快速开始模板
# ============================================================================
# 
# 使用说明：
# 1. 根据部署环境选择对应的配置块（本地/远程）
# 2. 修改域名和 SECRET_KEY
# 3. 其余默认配置通常无需修改
# 4. 运行：docker compose up -d
#
# ============================================================================

# ============================================================================
# 方案 A：本地开发部署 (localhost)
# ============================================================================
# 取消注释以下行，注释掉方案 B 和方案 C

CONSOLE_API_URL=http://localhost:5001
CONSOLE_WEB_URL=http://localhost
APP_API_URL=http://localhost:5001
FILES_URL=http://localhost:5001
INTERNAL_FILES_URL=http://api:5001

COOKIE_DOMAIN=localhost
WEB_API_CORS_ALLOW_ORIGINS=http://localhost
CONSOLE_CORS_ALLOW_ORIGINS=http://localhost

# ============================================================================
# 方案 B：远程单一域名部署 (example.com)
# ============================================================================
# 取消注释以下行，替换 example.com，注释掉方案 A 和方案 C
# 需要配置 Nginx 反向代理（见部署指南）

# CONSOLE_API_URL=https://api.example.com
# CONSOLE_WEB_URL=https://example.com
# APP_API_URL=https://api.example.com
# FILES_URL=https://api.example.com
# INTERNAL_FILES_URL=http://api:5001
# 
# COOKIE_DOMAIN=example.com
# WEB_API_CORS_ALLOW_ORIGINS=https://example.com,https://api.example.com
# CONSOLE_CORS_ALLOW_ORIGINS=https://example.com,https://api.example.com

# ============================================================================
# 方案 C：远程子域分离部署 (console.example.com + api.example.com)
# ============================================================================
# 取消注释以下行，替换 example.com，注释掉方案 A 和方案 B
# 需要配置 Nginx 反向代理（见部署指南）

# CONSOLE_API_URL=https://api.example.com
# CONSOLE_WEB_URL=https://console.example.com
# APP_API_URL=https://api.example.com
# FILES_URL=https://api.example.com
# INTERNAL_FILES_URL=http://api:5001
# 
# COOKIE_DOMAIN=.example.com
# NEXT_PUBLIC_COOKIE_DOMAIN=1
# WEB_API_CORS_ALLOW_ORIGINS=https://console.example.com,https://api.example.com
# CONSOLE_CORS_ALLOW_ORIGINS=https://console.example.com,https://api.example.com

# ============================================================================
# 第 2 步：设置 SECRET_KEY（必须修改！）
# ============================================================================
# 
# 生成方法：执行命令
#   openssl rand -base64 42
# 然后复制输出的 64 个字符粘贴到下面
# 
# 示例（勿直接使用）：
#   SECRET_KEY=/Iu5VKtjOwqqBqjAxCtzIGMdZI69Nejnq8xSvEwzMd7RAZZGB1VAb365

SECRET_KEY=请执行: openssl rand -base64 42 获取密钥后填写

# ============================================================================
# 数据库配置
# ============================================================================
# 通常保持默认值，除非有特殊需求

DB_USERNAME=postgres
DB_PASSWORD=difyai123456
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify

# ============================================================================
# Redis 配置
# ============================================================================
# 通常保持默认值

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# Vector 存储配置（默认使用 Weaviate）
# ============================================================================
VECTOR_STORE=weaviate
WEAVIATE_ENDPOINT=http://weaviate:8080
WEAVIATE_API_KEY=WVF5YThaHlkYwhGUSmCRgsX3tD5ngdN8pkih
WEAVIATE_GRPC_ENDPOINT=grpc://weaviate:50051

# ============================================================================
# 日志配置
# ============================================================================
LOG_LEVEL=INFO
DEBUG=false
FLASK_DEBUG=false

# ============================================================================
# 文件存储配置
# ============================================================================
# 默认使用本地存储，保存到 volumes/app/storage
STORAGE_TYPE=local

# ============================================================================
# 其他高级配置（通常无需修改）
# ============================================================================

SERVICE_API_URL=
TRIGGER_URL=http://localhost
APP_WEB_URL=

# 容器绑定地址和端口
DIFY_BIND_ADDRESS=0.0.0.0
DIFY_PORT=5001

# API 工作进程配置
SERVER_WORKER_AMOUNT=1
SERVER_WORKER_CLASS=gevent
SERVER_WORKER_CONNECTIONS=10
GUNICORN_TIMEOUT=360

# Celery 配置
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CLASS=gevent
CELERY_WORKER_AMOUNT=1

# 编码设置
LANG=C.UTF-8
LC_ALL=C.UTF-8
PYTHONIOENCODING=utf-8

# Token 过期时间
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# 迁移配置
MIGRATION_ENABLED=true

# ============================================================================
# 快速验证：部署后运行
# ============================================================================
# 
# 1. 检查容器状态
#    docker compose ps
#
# 2. 测试 API 连接
#    curl -i http://localhost:5001/console/api/workspaces
#    应返回 HTTP 401（认证错误为正常）
#
# 3. 访问前端
#    http://localhost/install  (本地环境)
#    https://example.com/install  (远程环境)
#
# 4. 创建管理员账户，完成初始化
#
# ============================================================================
